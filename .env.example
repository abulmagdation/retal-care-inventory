# Server (Cloud Run provides PORT; configure MONGODB_URI and JWT_SECRET as secrets)
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/retal_care
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h
# Optional: only needed when the frontend is hosted on another origin
CLIENT_URL=http://localhost:5173
SEED_ADMIN_EMAIL=admin@retalcare.com
SEED_ADMIN_PASSWORD=replace-with-a-unique-password

# Client (set to true to explore the UI without a running API)
VITE_DEMO_MODE=false
# Optional: the frontend uses /api on the same origin by default
# VITE_API_URL=http://localhost:5000/api
